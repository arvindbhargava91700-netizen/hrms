Options -Indexes

<IfModule mod_rewrite.c>

    RewriteEngine On

   RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.feetrackhrms.bestitcompanylucknow\.com$ [NC]
    RewriteRule ^ https://feetrackhrms.bestitcompanylucknow.com%{REQUEST_URI} [R=301,L,NE]

    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|vendor)(?:/|$) - [F,L,NC]


    RewriteRule ^(?:\.env|\.env\..*|artisan|composer\.json|composer\.lock|package\.json|package-lock\.json|phpunit\.xml|phpunit\.xml\.dist)$ - [F,L,NC]

    RewriteRule ^(?:\.git|\.svn|\.hg|\.bzr)(?:/|$) - [F,L,NC]

    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]

    RewriteRule \.(?:bak|backup|old|orig|save|swp|swo|tmp|temp|sql|sqlite|log|ini|conf|yml|yaml)$ - [F,L,NC]

    RewriteRule ^(?:Dockerfile|docker-compose.*|Makefile|README.*|LICENSE.*)$ - [F,L,NC]

    RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>

<FilesMatch "(^\.|\.env|composer\.json|composer\.lock|package\.json|package-lock\.json|phpunit\.xml|artisan|\.sql$|\.sqlite$|\.log$|\.bak$|\.backup$|\.old$|\.orig$|\.ini$|\.conf$|\.yml$|\.yaml$)">
    Require all denied
</FilesMatch>